# Confluence Data Center Credentials
#
# Copy this file to one of:
#   .env
#   .env.confluence
#   .env.jira
#   .env.atlassian
#
# Then fill in your actual credentials.
#
# NOTE: The scripts also auto-discover credentials from MCP config files
# (e.g., ~/.claude/mcp.json, .mcp.json). You only need this .env file if
# MCP config is not available or you prefer explicit environment variables.

# Confluence Data Center host URL (no /wiki suffix needed)
CONFLUENCE_HOST=https://confluence.yourcompany.com

# Personal Access Token (PAT)
# Generate at: https://confluence.yourcompany.com/plugins/personalaccesstokens/usertokens.action
CONFLUENCE_API_TOKEN=your_personal_access_token_here

# Optional: Default output directory for downloads
# CONFLUENCE_OUTPUT_DIR=confluence_docs
