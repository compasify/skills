# Confluence Data Center Instance Configuration
CONFLUENCE_HOST=https://confluence.yourcompany.com
CONFLUENCE_API_TOKEN=your_personal_access_token_here

# Optional: Output directory (default: ./confluence_docs)
CONFLUENCE_OUTPUT_DIR=./confluence_docs

# How to get a Personal Access Token (PAT):
# 1. Go to your Confluence DC instance
# 2. Click your profile picture → Settings → Personal Access Tokens
# 3. Click "Create token"
# 4. Give it a name (e.g., "Claude Confluence Skill")
# 5. Copy the token and paste it above as CONFLUENCE_API_TOKEN
#
# Note: Keep this file secure and do NOT commit it to version control!
#
# The scripts also auto-discover credentials from MCP config files
# (e.g., ~/.claude/mcp.json, .mcp.json). You only need this .env file
# if MCP config is not available.
